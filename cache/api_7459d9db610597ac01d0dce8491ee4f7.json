th":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":790,"title":"Senior Wing Library content","content":"<p class=\"MsoNormal\">The Senior Wing Library Reading Programme is designed to\r\ncultivate a lifelong love for reading while strengthening critical thinking,\r\ncomprehension and analytical skills among students. The programme encourages\r\nlearners to explore a wide range of genres, including fiction, non-fiction,\r\nbiographies, classics and contemporary literature, aligned with their academic\r\nand personal interests.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">Structured reading schedules, guided reading sessions, book\r\nreviews and reflective discussions help students develop deeper understanding,\r\narticulate perspectives and build strong language proficiency. Special\r\ninitiatives such as author studies, thematic reading weeks and reading\r\nchallenges further enhance engagement.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">Through this programme, the library becomes a dynamic\r\nlearning space that nurtures intellectual curiosity, independent thinking, and\r\ninformed global citizens.<o:p><\/o:p><\/p>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:15:04.103000Z","updated_at":"2026-01-19T07:16:07.210000Z","page_section_id":"1982","content_heading":"Senior Wing Library content","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}