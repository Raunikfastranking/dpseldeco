contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-size: 32px; margin-top: 0px; margin-bottom: 0.25rem; margin-left: 7rem; position: relative; line-height: 2.25rem; --tw-text-opacity: 1; color: rgb(255, 255, 255); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">Primary Wing Library<\/h2>","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]},{"id":1997,"title":"Primary Wing Library content section eldeco","description":null,"order":2,"layout":"content","is_active":true,"created_at":"2025-09-22T09:19:51.127000Z","updated_at":"2025-09-22T09:19:51.127000Z","page_id":"1115","content":null,"content_heading":"Primary Wing Library content section eldeco","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[{"id":795,"title":"Primary Wing Library image","content":null,"content_type":"image","image_path":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1774595536_z3tCtVm9gy.jpeg","image_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1774595536_z3tCtVm9gy.jpeg","link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:20:24.067000Z","updated_at":"2026-03-27T07:12:16.947000Z","page_section_id":"1997","content_heading":"Primary Wing Library image","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":796,"title":"Primary Wing Library  content","content":"<p class=\"MsoNormal\">The Primary Wing Library Reading Programme is designed to\r\nnurture a love for books and develop early reading skills in young learners.\r\nThrough engaging and age-appropriate literature, the programme helps children\r\nbuild vocabulary, improve comprehension and develop listening and speaking\r\nskills in a joyful learning environment.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">Students are introduced to a wide range of picture books,\r\nstorybooks, rhymes, folk tales and simple informational texts. Regular library\r\nperiods, storytelling sessions, read-aloud activities and guided reading help\r\nstrengthen imagination, curiosity and language development. Activities such as\r\nbook browsing, character talks and simple reflections encourage confidence and\r\nself-expression.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">The programme lays a strong foundation for lifelong reading\r\nhabits, making the library a welcoming space where learning begins with stories\r\nand grows with imagination.<o:p><\/o:p><\/p>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:21:10.143000Z","updated_at":"2026-01-19T07:20:05.630000Z","page_section_id":"1997","content_heading":"<div><font color=\"#000000\" face=\"ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji\">Primary Wing Library  content<br><\/font><\/div>","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}