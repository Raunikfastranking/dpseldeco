\ud835\\udc2c\\ud835\\udc22\\ud835\\udc1c\\ud835\\udc1a\\ud835\\udc25 \\ud835\\udc02\\ud835\\udc21\\ud835\\udc1a\\ud835\\udc22\\ud835\\udc2b\\ud835\\udc2c and \\ud835\\udc13\\ud835\\udc2e\\ud835\\udc20 \\ud835\\udc28\\ud835\\udc1f \\ud835\\udc16\\ud835\\udc1a\\ud835\\udc2b, making the day energetic, joyful and memorable.<\\\/div><\\\/div>\",\"gallery_type\":\"gallery\",\"gallery_sub_type\":{\"id\":31,\"gallery_type\":\"gallery\",\"sub_type_name\":\"media_gallery\",\"description\":null,\"is_active\":true,\"sort_order\":0,\"created_at\":null,\"updated_at\":null},\"gallery_title\":\"L'IL Champs: Where Little Feet Ran Towards Big Dreams\",\"gallery_slug\":\"lil-champs-where-little-feet-ran-towards-big-dreams\",\"status\":\"active\",\"publish_status\":\"published\",\"sort_order\":0,\"page_id\":\"1159\",\"section_id\":null,\"school_id\":\"1\",\"branch_id\":\"2\",\"language_id\":null,\"description\":null,\"meta_title\":null,\"meta_description\":null,\"meta_keywords\":null,\"created_at\":\"2026-02-13T03:59:18.617000Z\",\"updated_at\":\"2026-02-13T03:59:18.617000Z\",\"date\":\"2026-02-09\",\"page\":{\"id\":1159,\"title\":\"Media-Gallery page Eldeco\",\"meta_description\":null,\"meta_keywords\":null,\"status\":\"published\",\"template\":\"default\",\"created_at\":\"2025-09-22T03:56:01.787000Z\",\"updated_at\":\"2025-09-22T11:05:50.140000Z\",\"slug\":\"media-gallery-page-eldeco\",\"language_id\":\"1\",\"language_code\":\"en\",\"translation_group\":\"page_group_1758533161_1637\",\"language\":\"en\",\"school_id\":\"1\",\"branch_id\":\"2\",\"breadcrumb_style\":null,\"breadcrumbs\":null,\"page_heading\":\"Media-Gallery page Eldeco\",\"default_sections\":\"2\"},\"section\":null,\"school\":{\"id\":1,\"name\":\"Delhi Public School\",\"description\":\"Delhi Public School\",\"logo\":\"\",\"website\":\"\",\"email\":\"\",\"phone\":\"\",\"address\":\"\",\"city\":\"\",\"state\":\"\",\"country\":\"\",\"postal_code\":\"\",\"principal_name\":\"\",\"principal_email\":\"\",\"principal_phone\":\