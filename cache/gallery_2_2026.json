ough MUN debates, negotiations, moderated caucuses, and resolution-building, students strengthened their skills in public speaking, research, critical thinking, diplomacy, negotiation, and leadership.<\\\/p>\\r\\n<p>A powerful celebration of young minds, global perspectives, and leadership with purpose. \\ud83c\\udf0f\\u2728<\\\/p>\",\"gallery_type\":\"gallery\",\"gallery_sub_type\":{\"id\":1,\"gallery_type\":\"gallery\",\"sub_type_name\":\"photo_gallery\",\"description\":null,\"is_active\":true,\"sort_order\":0,\"created_at\":\"2025-10-11T07:13:36.895000Z\",\"updated_at\":\"2025-10-11T07:16:12.050000Z\"},\"gallery_title\":\"Model United Nations at DPS Eldeco | Young Diplomats, Global Leaders ??\",\"gallery_slug\":\"model-united-nations-at-dps-eldeco-young-diplomats-global-leaders\",\"status\":\"active\",\"publish_status\":\"published\",\"sort_order\":0,\"page_id\":\"1156\",\"section_id\":null,\"school_id\":\"1\",\"branch_id\":\"2\",\"language_id\":null,\"description\":null,\"meta_title\":null,\"meta_description\":null,\"meta_keywords\":null,\"created_at\":\"2026-11-05T09:22:54.603000Z\",\"updated_at\":\"2026-11-05T09:23:23.257000Z\",\"date\":\"2026-08-22\",\"page\":{\"id\":1156,\"title\":\"Photo Gallery page Eldeco\",\"meta_description\":null,\"meta_keywords\":null,\"status\":\"published\",\"template\":\"default\",\"created_at\":\"2025-09-22T03:55:48.513000Z\",\"updated_at\":\"2026-03-17T09:14:00.223000Z\",\"slug\":\"photo-gallery-page-eldeco\",\"language_id\":\"1\",\"language_code\":\"en\",\"translation_group\":\"page_group_1758533148_6807\",\"language\":\"en\",\"school_id\":\"1\",\"branch_id\":\"2\",\"breadcrumb_style\":null,\"breadcrumbs\":null,\"page_heading\":\"Photo Gallery page Eldeco\",\"default_sections\":\"2\"},\"section\":null,\"school\":{\"id\":1,\"name\":\"Delhi Public School\",\"description\":\"Delhi Public School\",\"logo\":\"\",\"website\":\"\",\"email\":\"\",\"phone\":\"\",\"address\":\"\",\"city\":\"\",\"state\":\"\",\"country\":\"\",\"postal_code