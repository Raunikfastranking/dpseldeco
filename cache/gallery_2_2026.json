oke<\\\/span><\\\/p>\\r\\n<\\\/div>\\r\\n<\\\/div>\\r\\n<\\\/li>\\r\\n<\\\/ul>\\r\\n<p><span>These achievements reflect hard work, perseverance and a true spirit of excellence. Heartiest congratulations to both swimmers for their inspiring success!<\\\/span><\\\/p>\",\"gallery_type\":\"achievements\",\"gallery_sub_type\":{\"id\":35,\"gallery_type\":\"achievements\",\"sub_type_name\":\"sport_academy_achievements\",\"description\":\"Sport Academy Achievements\",\"is_active\":true,\"sort_order\":0,\"created_at\":null,\"updated_at\":null},\"gallery_title\":\"Inter-School Swimming Championship 2026\",\"gallery_slug\":\"inter-school-swimming-championship-2026\",\"status\":\"active\",\"publish_status\":\"published\",\"sort_order\":0,\"page_id\":\"1143\",\"section_id\":null,\"school_id\":\"1\",\"branch_id\":\"2\",\"language_id\":null,\"description\":null,\"meta_title\":null,\"meta_description\":null,\"meta_keywords\":null,\"created_at\":\"2026-11-05T06:14:20.867000Z\",\"updated_at\":\"2026-11-05T06:14:20.867000Z\",\"date\":\"2026-11-05\",\"page\":{\"id\":1143,\"title\":\"Sports Academy Achievements page Eldeco\",\"meta_description\":null,\"meta_keywords\":null,\"status\":\"published\",\"template\":\"default\",\"created_at\":\"2025-09-22T03:54:22.407000Z\",\"updated_at\":\"2025-11-18T10:04:18.683000Z\",\"slug\":\"sports-academy-achievements-page-eldeco\",\"language_id\":\"1\",\"language_code\":\"en\",\"translation_group\":\"page_group_1758533062_1126\",\"language\":\"en\",\"school_id\":\"1\",\"branch_id\":\"2\",\"breadcrumb_style\":\"default\",\"breadcrumbs\":null,\"page_heading\":\"Sports Academy Achievements page Eldeco\",\"default_sections\":\"2\"},\"section\":null,\"school\":{\"id\":1,\"name\":\"Delhi Public School\",\"description\":\"Delhi Public School\",\"logo\":\"\",\"website\":\"\",\"email\":\"\",\"phone\":\"\",\"address\":\"\",\"city\":\"\",\"state\":\"\",\"country\":\"\",\"postal_code\":\"\",\"principal_name\":\"\",\"principal_email\":\"\",\"principal_phone\":\"\"