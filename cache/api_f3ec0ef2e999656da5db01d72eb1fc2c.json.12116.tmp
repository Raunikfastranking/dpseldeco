rder-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-size: 32px; margin-top: 0px; margin-bottom: 0.25rem; margin-left: 7rem; position: relative; line-height: 2.25rem; --tw-text-opacity: 1; color: rgb(255, 255, 255); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">Robotics<\/h2>","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]},{"id":1830,"title":"robotics content section eldeco","description":null,"order":2,"layout":"content","is_active":true,"created_at":"2025-09-22T08:15:27.977000Z","updated_at":"2025-09-22T08:15:27.977000Z","page_id":"1093","content":null,"content_heading":"robotics content section eldeco","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[{"id":733,"title":"robotics image","content":"","content_type":"image","image_path":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1758548747_qnjqCXLDjM.webp","image_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1758548747_qnjqCXLDjM.webp","link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T08:15:47.120000Z","updated_at":"2025-09-22T08:15:47.120000Z","page_section_id":"1830","content_heading":"robotics image","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":734,"title":"robotics content","content":"<span style=\"color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;\">At the advanced level, robotics becomes an exciting challenge. Students build robots using Arduino or LEGO EV3 kits, program movement using sensors, and participate in competitive robotics challenges that enhance their engineering mindset. Robotics education introduces students to the exciting intersection of science, technology, engineering, and mathematics (STEM) through practical, hands-on experiences. By building and programming robots, students learn how to apply theoretical concepts to real-world scenarios. This fosters a deep understanding of mechanics, electronics, and computing. Robotics challenges students to think critically, troubleshoot systematically, and innovate creatively. In a world increasingly shaped by automation and artificial intelligence, introducing robotics at the school level ensures that students are not only prepared for future careers but are also inspired to become inventors, engineers, and solution-seekers.<\/span>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T08:16:08.143000Z","updated_at":"2025-09-22T08:16:08.143000Z","page_section_id":"1830","content_heading":"robotics content","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}