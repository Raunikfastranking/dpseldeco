.5pt;vertical-align:top;padding:5pt 5pt 5pt 5pt;overflow:hidden;overflow-wrap:break-word;\"><p dir=\"ltr\" style=\"line-height:1.7999999999999998;text-align: justify;margin-top:10pt;margin-bottom:0pt;\"><span style=\"font-size: 12pt; color: rgb(0, 0, 0); background-color: transparent; font-variant: normal; vertical-align: baseline; white-space: pre-wrap;\"><font face=\"Georgia\">Hands-on exploration<\/font><\/span><\/p><\/td><\/tr><tr style=\"height:25pt\"><td style=\"border-left:solid #000000 0.5pt;border-right:solid #000000 0.5pt;border-bottom:solid #000000 0.5pt;border-top:solid #000000 0.5pt;vertical-align:top;padding:5pt 5pt 5pt 5pt;overflow:hidden;overflow-wrap:break-word;\"><p dir=\"ltr\" style=\"line-height:1.7999999999999998;text-align: justify;margin-top:10pt;margin-bottom:0pt;\"><span style=\"font-size: 12pt; color: rgb(0, 0, 0); background-color: transparent; font-variant: normal; vertical-align: baseline; white-space: pre-wrap;\"><font face=\"Georgia\">One-way teaching<\/font><\/span><\/p><\/td><td style=\"border-left:solid #000000 0.5pt;border-right:solid #000000 0.5pt;border-bottom:solid #000000 0.5pt;border-top:solid #000000 0.5pt;vertical-align:top;padding:5pt 5pt 5pt 5pt;overflow:hidden;overflow-wrap:break-word;\"><p dir=\"ltr\" style=\"line-height:1.7999999999999998;text-align: justify;margin-top:10pt;margin-bottom:0pt;\"><span style=\"font-size: 12pt; color: rgb(0, 0, 0); background-color: transparent; font-variant: normal; vertical-align: baseline; white-space: pre-wrap;\"><font face=\"Georgia\">Interactive participation<\/font><\/span><\/p><\/td><\/tr><tr style=\"height:25pt\"><td style=\"border-left:solid #000000 0.5pt;border-right:solid #000000 0.5pt;border-bottom:solid #000000 0.5pt;border-top:solid #000000 0.5pt;vertical-align:top;padding:5pt 5pt 5pt 5pt;overflow:hidden;overflow-wrap:break-word;\"><p dir=\"ltr\" style=\"line-height:1.7999999999999998;text-align: justify;margin-top:10pt;margin-bottom:0pt;\"><span style=\"font-size: 12pt; col