e and fair play. Students displayed remarkable skill and enthusiasm throughout the event. <strong data-start=\"498\" data-end=\"553\">Winners were honored with trophies and certificates<\/strong>, while all participants were applauded. The tournament promoted <strong data-start=\"618\" data-end=\"679\">physical fitness, mental strength and character building<\/strong>, inspiring students to actively pursue sports alongside academics.","gallery_type":"gallery","gallery_sub_type":{"id":31,"gallery_type":"gallery","sub_type_name":"media_gallery","description":null,"is_active":true,"sort_order":0,"created_at":null,"updated_at":null},"gallery_title":"DPS Eldeco Successfully Hosts Inter-School Basketball Tournament","gallery_slug":"dps-eldeco-successfully-hosts-inter-school-basketball-tournament","status":"active","publish_status":"published","sort_order":0,"page_id":"1159","section_id":null,"school_id":"1","branch_id":"2","language_id":null,"description":null,"meta_title":null,"meta_description":null,"meta_keywords":null,"created_at":"2026-01-28T07:32:51.463000Z","updated_at":"2026-01-28T07:32:51.463000Z","date":"2026-01-17","page":{"id":1159,"title":"Media-Gallery page Eldeco","meta_description":null,"meta_keywords":null,"status":"published","template":"default","created_at":"2025-09-22T03:56:01.787000Z","updated_at":"2025-09-22T11:05:50.140000Z","slug":"media-gallery-page-eldeco","language_id":"1","language_code":"en","translation_group":"page_group_1758533161_1637","language":"en","school_id":"1","branch_id":"2","breadcrumb_style":null,"breadcrumbs":null,"page_heading":"Media-Gallery page Eldeco","default_sections":"2"},"section":null,"school":{"id":1,"name":"Delhi Public School","description":"Delhi Public School","logo":"","website":"","email":"","phone":"","address":"","city":"","state":"","country":"","postal_code":"","principal_name":"","principal_email":"","principal_phone":"","established_year":null,"accreditation":"","mission":"","vision":"","core_values":"","