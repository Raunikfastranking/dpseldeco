age_id":"1","school_id":"1","created_at":"2025-08-28T05:14:01.467000Z","updated_at":"2025-09-12T11:16:24.683000Z","slug":"test-branch-2025-08-28-104401","logo":""},"language":null,"media":[{"id":589,"gallery_id":"212","media_type":"image","media_file":"upload\/images\/gallery\/TlhPPauT3r.jpeg","media_alt_text":null,"media_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/gallery\/TlhPPauT3r.jpeg","caption":null,"page_link":null,"heading_link":null,"sort_order":1,"created_at":"2026-02-16T06:08:14.610000Z","updated_at":"2026-02-16T06:08:14.610000Z","event_date":null,"class_name":null,"heading":null,"content":null,"redirect_url":null,"image_link":null,"class_id":null},{"id":590,"gallery_id":"212","media_type":"image","media_file":"upload\/images\/gallery\/xsfkRul8RF.jpeg","media_alt_text":null,"media_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/gallery\/xsfkRul8RF.jpeg","caption":null,"page_link":null,"heading_link":null,"sort_order":2,"created_at":"2026-02-16T06:08:14.623000Z","updated_at":"2026-02-16T06:08:14.623000Z","event_date":null,"class_name":null,"heading":null,"content":null,"redirect_url":null,"image_link":null,"class_id":null},{"id":591,"gallery_id":"212","media_type":"image","media_file":"upload\/images\/gallery\/HnsptbeQlH.jpeg","media_alt_text":null,"media_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/gallery\/HnsptbeQlH.jpeg","caption":null,"page_link":null,"heading_link":null,"sort_order":3,"created_at":"2026-02-16T06:08:14.637000Z","updated_at":"2026-02-16T06:08:14.637000Z","event_date":null,"class_name":null,"heading":null,"content":null,"redirect_url":null,"image_link":null,"class_id":null},{"id":592,"gallery_id":"212","media_type":"image","media_file":"upload\/images\/gallery\/oIjBlgl3u2.jpeg","media_alt_text":null,"media_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/gallery\/oIjBlgl3u2.jpeg","caption":null,"page_link":null,"heading_link":null,"sort_order":4,"created_at":"2026-02-16T06:08:14.650000Z","updated_at":"2026-02-16T06:08:14.650000Z","event_date":null,"class_name":null,"heading":null,"content":null,"redirect_url":null,"image_link":null,"class_id":null}]},{"id":214,"heading":"\ud83c\udf1f Triumph at CIN\u00c8VO 2026 \u2013 A Star-Making Moment! \ud83c\udf1f","content":"<p data-start=\"49\" data-end=\"162\">Some victories are measured in trophies \u2014 others in the confidence, creativity and teamwork that lead to them.<\/p>\r\n<p data-start=\"164\" data-end=\"421\">At <strong data-start=\"167\" data-end=\"177\">CIN\u00c8VO<\/strong>, hosted by <span class=\"hover:entity-accent entity-underline inline cursor-pointer align-baseline\">Allen House Public School<\/span>, our young visionaries left an unforgettable mark by securing <strong data-start=\"289\" data-end=\"338\">First Position in two out of three categories<\/strong> and proudly bringing home the prestigious <strong data-start=\"381\" data-end=\"414\">OVERALL Star Spotlight Trophy<\/strong>. \ud83c\udfc6\u2728<\/p>\r\n<p data-start=\"423\" data-end=\"504\">This achievement reflects the passion and dedication of our brilliant students:<\/p>\r\n<p data-start=\"506\" data-end=\"785\">\ud83c\udf1f <strong data-start=\"509\" data-end=\"528\">Tejas Kesarwani<\/strong> \u2013 XI C<br data-start=\"535\" data-end=\"538\">\r\n\ud83c\udf1f <strong data-start=\"541\" data-end=\"556\">Skand Singh<\/strong> \u2013 XI C<br data-start=\"563\" data-end=\"566\">\r\n\ud83c\udf1f <strong data-start=\"569\" data-end=\"591\">Shourya Srivastava<\/strong> \u2013 XI C<br data-start=\"598\" data-end=\"601\">\r\n\ud83c\udf1f <strong data-start=\"604\" data-end=\"624\">Saksham Tripathi<\/strong> \u2013 XI C<br data-start=\"631\" data-end=\"634\">\r\n\ud83c\udf1f <strong data-start=\"637\" data-end=\"654\">Bushra Zuberi<\/strong> \u2013 XI A<br data-start=\"661\" data-end=\"664\">\r\n\ud83c\udf1f <strong data-start=\"667\" data-end=\"681\">Avni Dixit<\/strong> \u2013 XI A<br data-start=\"688\" data-end=\"691\">\r\n\ud83c\udf1f <strong data-start=\"694\" data-end=\"711\">Ashwita Singh<\/strong> \u2013 XI A<br data-start=\"718\" data-end=\"721\">\r\n\ud83c\udf1f <strong data-start=\"724\" data-end=\"747\">Prakhar Anand Singh<\/strong> \u2013 XI D<br data-start=\"754\" data-end=\"757\">\r\n\ud83c\udf1f <strong data-start=\"760\" data-end=\"776\">Ayesha Nazir<\/strong> \u2013 XI A<\/p>\r\n<p data-start=\"787\" data-end=\"928\">Your commitment, creativity and collaborative spirit have truly defined excellence. May this success be just one of many milestones ahead.<\/p>","gallery_type":"achievements","gallery_sub_type":{"id":33,"gallery_type":"achievements","sub_type_name":"extra_curricular","description":"Extra Curricular","is_active":true,"sort_order":0,"created_at":null,"updated_at":null},"gallery_title":"?? Triumph at CIN\u00c8VO 2026 \u2013 A Star-Making Moment! ??","gallery_slug":"triumph-at-cinevo-2026-a-star-making-moment","status":"active","publish_status":"published","sort_order":0,"page_id":"1142","section_id":null,"school_id":"1","branch_id":"2","language_id":null,"description":null,"meta_title":null,"meta_description":null,"meta_keywords":null,"created_at":"2026-02-16T06:25:20.317000Z","updated_at":"2026-02-16T06:25:20.317000Z","date":"2026-02-16","page":{"id":1142,"title":"Extra-Curricular Achievements page Eldeco","meta_description":null,"meta_keywords":null,"status":"published","template":"default","created_at":"2025-09-22T03:54:13.690000Z","updated_at":"2026-02-14T08:28:07.487000Z","slug":"extra-curricular-achievements-page-eldeco","language_id":"1","language_code":"en","translation_group":"page_group_1758533053_4962","language":"en","school_id":"1","branch_id":"2","breadcrumb_style":"default","breadcrumbs":null,"page_heading":"Extra-Curricular Achievements page Eldeco","default_sections":"2"},"section":null,"school":{"id":1,"name":"Delhi Public School","description":"Delhi Public School","logo":"","website":"","email":"","phone":"","address":"","city":"","state":"","countr