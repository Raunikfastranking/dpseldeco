Z","slug":"sports-academy-achievements-page-eldeco","language_id":"1","language_code":"en","translation_group":"page_group_1758533062_1126","language":"en","school_id":"1","branch_id":"2","breadcrumb_style":"default","breadcrumbs":null,"page_heading":"Sports Academy Achievements page Eldeco","default_sections":"2"},"section":null,"school":{"id":1,"name":"Delhi Public School","description":"Delhi Public School","logo":"","website":"","email":"","phone":"","address":"","city":"","state":"","country":"","postal_code":"","principal_name":"","principal_email":"","principal_phone":"","established_year":null,"accreditation":"","mission":"","vision":"","core_values":"","status":"active","meta_title":"","meta_description":"","meta_keywords":"","language":null,"language_id":"1","created_at":"2025-08-07T20:31:54.000000Z","updated_at":"2025-12-13T17:21:25.200000Z","slug":"delhi-public-scool"},"branch":{"id":2,"name":"Eldeco","description":"Dps Eldeco","branch_code":"","address":"Sector II, Raksha khand Udhyan II,Eldeco Colony,\r\nRai Barelly Road","city":"Distt Lucknow","state":"Uttar Pradesh","country":"","postal_code":"226025","phone":"+91 5224081945 ,  +91 7522002115","email":"contact@dpseldeco.com","website":"","branch_head_name":"","branch_head_email":"","branch_head_phone":"","capacity":0,"current_students":0,"facilities":"","special_features":"","status":"active","meta_title":"Test Branch - Meta Title","meta_description":"Test branch meta description","meta_keywords":"test, branch, school","language":null,"language_id":"1","school_id":"1","created_at":"2025-08-28T05:14:01.467000Z","updated_at":"2025-09-12T11:16:24.683000Z","slug":"test-branch-2025-08-28-104401","logo":""},"language":null,"media":[{"id":465,"gallery_id":"165","media_type":"image","media_file":"upload\/images\/gallery\/BsJAd6Ur66.png","media_alt_text":null,"media_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/gallery\/BsJAd6Ur66.png","caption":null,"page_link":null,"heading_link":null,"sort_order":1,"created_at":"2026-01-30T05:30:59.733000Z","updated_at":"2026-01-30T05:30:59.733000Z","event_date":null,"class_name":null,"heading":null,"content":null,"redirect_url":null,"image_link":null,"class_id":null}]},{"id":166,"heading":"Pride of DPS, Eldeco: Akshat Rai Shines at Vidyarthi Vigyan Manthan","content":"<div class=\"xdj266r x14z9mp xat24cr x1lziwak x1vvkbs x126k92a\" style=\"overflow-wrap: break-word; white-space-collapse: preserve; margin-inline: 0px; margin-bottom: 0px; margin-top: 0px; font-family: &quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif; color: rgb(8, 8, 9); font-size: 15px;\"><div dir=\"auto\" style=\"font-family: inherit;\"><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\" style=\"text-align: inherit; overflow-wrap: break-word; display: inline-flex; vertical-align: middle; width: 16px; height: 16px; padding-inline: 0px; margin-inline: 1px; padding-bottom: 0px; margin-bottom: 0px; margin-top: 0px; padding-top: 0px; font-family: inherit;\"><br><\/span><\/div><\/div><div class=\"x14z9mp xat24cr x1lziwak x1vvkbs xtlvy1s x126k92a\" style=\"overflow-wrap: break-word; white-space-collapse: preserve; margin-top: 0.5em; margin-inline: 0px; margin-bottom: 0px; font-family: &quot;Segoe UI Historic&quot;, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif; color: rgb(8, 8, 9); font-size: 15px;\"><div dir=\"auto\" style=\"font-family: inherit;\">We are delighted to share that \ud835\udc00\ud835\udc24\ud835\udc2c\ud835\udc21\ud835\udc1a\ud835\udc2d \ud835\udc11\ud835\udc1a\ud835\udc22 (\ud835\udc02\ud835\udc25\ud835\udc1a\ud835\udc2c\ud835\udc2c \ud835\udfd6-\ud835\udc03) has secured Second Position at the Vidyarthi Vigyan Manthan State Level Camp and has been selected for the \ud835\udc0d\ud835\udc1a\ud835\udc2d\ud835\udc22\ud835\udc28\ud835\udc27\ud835\udc1a\ud835\udc25 \ud835\udc0b\ud835\udc1e\ud835\udc2f\ud835\udc1e\ud835\udc25. He also achieved Second Rank in the Awadh Region across Uttar Pradesh <\/div><div dir=\"auto\" style=\"font-family: inherit;\">This outstanding accomplishment brings immense pride to our school. <span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\" style=\"text-align: inherit; overflow-wrap: break-word; display: inline-flex; vertical-align: middle; width: 16px; height: 16px; padding-inline: 0px; margin-inline: 1px; padding-bottom: 0px; margin-bottom: 0px; margin-top: 0px; padding-top: 0px; font-family: inherit;\"><img height=\"16\" width=\"16\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" alt=\"\ud83d\udc4f\" referrerpolicy=\"origin-when-cross-origin\" src=\"https:\/\/static.xx.fbcdn.net\/images\/emoji.php\/v9\/tfe\/1\/16\/1f44f.png\" style=\"border: 0px; border-start-start-radius: 0px; border-end-end-radius: 0px; border-start-end-radius: 0px; border-end-start-radius: 0px; object-fit: fill;\"><\/span><span class=\"html-span xexx8yu xyri2b x18d9i69 x1c1uobl x1hl2dhg x16tdsg8 x1vvkbs x3nfvp2 x1j61x8r x1fcty0u xdj266r xat24cr xm2jcoa x1mpyi22 xxymvpz xlup9mm x1kky2od\" style=\"text-align: inherit; overflow-wrap: break-word; display: inline-flex; vertical-align: middle; width: 16px; height: 16px; padding-inline: 0px; margin-inline: 1px; padding-bottom: 0px; margin-bottom: 0px; margin-top: 0px; padding-top: 0px; font-family: inherit;\"><img height=\"16\" width=\"16\" class=\"xz74otr x15mokao x1ga7v0g x16uus16 xbiv7yw\" alt=\"\u2728\" referrerpolicy=\"origin-when-cross-origin\" src=\"https:\/\/static.xx.fbcdn.net\/images\/emoji.php\/v9\/tf4\/1\/16\/2728.png\" style=\"border: 0px; border-start-start-radius: 0px; border-end-end-radius: 0px; border-start-end-radius: 0px; border-end-start-radius: 0px; object-fit: fill;\"><\/span><\/div><\/div>","gallery_type":"achievements","gallery_sub_type":{"id":34,"gallery_type":"achieveme