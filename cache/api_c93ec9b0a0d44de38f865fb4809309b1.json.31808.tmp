e: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); --tw-space-y-reverse: 0; margin-top: 12px; margin-bottom: 0px;\">Students are not allowed to go to a relative\u2019s or friend\u2019s house from school without prior permission of parents.<\/li><\/ol>","content_heading":"School Rules content section eldeco","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]}]}}