idth":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":794,"title":"Middle Wing Library content","content":"<p class=\"MsoNormal\">The Middle Wing Library Reading Programme aims to develop\r\nstrong reading habits, enhance comprehension and foster a love for books among\r\nstudents. The programme introduces learners to a wide variety of\r\nage-appropriate literature, including fiction, fantasy, adventure, biographies\r\nand informative texts, helping them discover the joy of reading while expanding\r\ntheir knowledge.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">Through structured library periods, guided reading sessions,\r\nbook talks and storytelling activities, students strengthen vocabulary, improve\r\nlanguage skills, and build confidence in expression. Reading journals, book\r\nreviews and interactive discussions encourage critical thinking and reflection.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">The programme nurtures curiosity, imagination and\r\nindependent learning, laying a strong foundation for academic growth and\r\nlifelong reading.<o:p><\/o:p><\/p>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:18:37.860000Z","updated_at":"2026-01-19T07:19:01.893000Z","page_section_id":"1991","content_heading":"Middle Wing Library content","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}