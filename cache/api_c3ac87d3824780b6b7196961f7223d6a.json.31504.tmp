yout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-size: 32px; margin-top: 0px; margin-bottom: 0.25rem; margin-left: 7rem; position: relative; line-height: 2.25rem; --tw-text-opacity: 1; color: rgb(255, 255, 255); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">Parent Teacher Association<\/h1>","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]},{"id":2144,"title":"Parent Teacher Association content section eldeco","description":null,"order":2,"layout":"content","is_active":true,"created_at":"2025-09-22T11:20:28.603000Z","updated_at":"2026-01-19T07:21:53.673000Z","page_id":"1192","content":"<p class=\"MsoNormal\">The Parent Teacher Association at DPS Eldeco serves as a\r\nstrong collaborative platform that fosters effective partnership between\r\nparents and the school. It plays a vital role in supporting academic progress,\r\nstudent well-being and the overall development of learners.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">Through regular meetings, discussions and feedback sessions,\r\nthe PTA encourages open communication, mutual understanding and shared\r\nresponsibility in nurturing students. The Association actively contributes to\r\nschool initiatives, events and decision-making processes, reinforcing a\r\npositive, inclusive and supportive school community.<o:p><\/o:p><\/p>","content_heading":"Parent Teacher Association content section eldeco","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]}]}}