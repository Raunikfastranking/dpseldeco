n-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); font-size: 32px; margin-top: 0px; margin-bottom: 0.25rem; margin-left: 7rem; position: relative; line-height: 2.25rem; --tw-text-opacity: 1; color: rgb(255, 255, 255); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">Social Initiatives<\/h2>","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]},{"id":2019,"title":"Social Initiatives content section eldeco","description":null,"order":2,"layout":"content","is_active":true,"created_at":"2025-09-22T09:30:18.953000Z","updated_at":"2026-02-13T03:48:33.560000Z","page_id":"1118","content":"At DPS Eldeco, social responsibility is an integral part of education. The school actively engages students\r\nin meaningful social initiatives that nurture empathy, compassion, and a sense of civic duty. Through\r\nstructured programmes and outreach activities, students are encouraged to understand societal\r\nchallenges and contribute positively to the community.\r\nOur initiatives include cleanliness drives, plantation campaigns, road safety awareness, health and\r\nhygiene programmes, and support for underprivileged communities. Students participate in donation\r\ndrives, environmental conservation activities, and awareness campaigns on social and national causes.\r\nBy actively involving students in these initiatives, DPS Eldeco instills the values of service, leadership,\r\nand responsible citizenship, empowering learners to become socially conscious individuals committed to\r\nmaking a positive difference in society.","content_heading":"Social Initiatives content section eldeco","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[{"id":803,"title":"Social Initiatives image","content":null,"content_type":"image","image_path":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1771056437_7K25cQ3ZPz.jpeg","image_url":"https:\/\/dps.allenhouseschools.com\/upload\/images\/pages\/1771056437_7K25cQ3ZPz.jpeg","link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:30:54.317000Z","updated_at":"2026-02-14T08:07:17.527000Z","page_section_id":"2019","content_heading":"Social Initiatives image","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":804,"title":"Plantation and Installation of Tree Guards","content":"<span style=\"color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">At DPS Eldeco, social responsibility is an integral part of education. The school actively engages students\r\nin meaningful social initiatives that nurture empathy, compassion, and a sense of civic duty. Through\r\nstructured programmes and outreach activities, students are encouraged to understand societal\r\nchallenges and contribute positively to the community.\r\nOur initiatives include cleanliness drives, plantation campaigns, road safety awareness, health and\r\nhygiene programmes, and support for underprivileged communities. Students participate in donation\r\ndrives, environmental conservation activities, and awareness campaigns on social and national causes.\r\nBy actively involving students in these initiatives, DPS Eldeco instills the values of service, leadership,\r\nand responsible citizenship, empowering learners to become socially conscious individuals committed to\r\nmaking a positive difference in society.<\/span>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:31:08.133000Z","updated_at":"2026-02-13T03:49:24.923000Z","page_section_id":"2019","content_heading":"<span style=\"color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\">Plantation and Installation of Tree&nbsp;Guards<\/span>","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}