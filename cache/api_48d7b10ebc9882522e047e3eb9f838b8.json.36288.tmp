-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0px; margin-bottom: 0px; color: rgb(0, 0, 0); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;\">Ultimately the whole purpose of education is to turn mirrors into&nbsp;windows.<\/p>","content_heading":"principal message 2 paragraph","table_json_data":null,"accordion_json_data":null,"gallery_json_data":null,"section_type":"content","alignment":"left","background_color":"#ffffff","text_color":"#333333","padding_top":"50","padding_bottom":"50","content_item_id":null,"content_item_type":null,"section_layout_id":null,"columns":[]}]}}