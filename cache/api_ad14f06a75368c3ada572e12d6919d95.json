mage_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":798,"title":"Pre Primary Wing Library content","content":"<p class=\"MsoNormal\">The Pre-Primary Wing Library Reading Programme is thoughtfully\r\ndesigned to introduce young learners to the magical world of books in a joyful\r\nand nurturing environment. The programme focuses on developing early literacy\r\nskills, listening abilities and a natural love for reading through playful and\r\ninteractive experiences.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">Children are exposed to a rich collection of picture books,\r\nstorybooks, rhymes, big books and tactile books that stimulate curiosity and\r\nimagination. Regular storytelling sessions, read-aloud activities, puppet shows\r\nand guided picture walks help enhance vocabulary, comprehension and attention\r\nskills.<o:p><\/o:p><\/p>\r\n\r\n<p class=\"MsoNormal\">The programme also encourages good reading habits through\r\nbook handling routines, library manners and parent\u2013child reading initiatives.\r\nBy making reading a fun and meaningful experience, the Pre-Primary Library\r\nProgramme lays a strong foundation for lifelong learning and a deep\r\nappreciation for books.<o:p><\/o:p><\/p>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-22T09:26:11.910000Z","updated_at":"2026-03-25T09:17:52.790000Z","page_section_id":"2006","content_heading":"Pre Primary Wing Library content","alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null}]}]}}